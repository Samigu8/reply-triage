{
  "name": "reply-triage",
  "version": "0.1.0",
  "description": "Classifies and drafts replies to outreach emails with an LLM, validates the output, and measures accuracy on a labeled test set.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts"
  },
