# Copy this file to .env and fill in your own key. Never commit .env.
GROQ_API_KEY=
# Any OpenAI-compatible provider works: change the base URL, model, and key.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check the exact model ID in your provider's console; free models change.
LLM_MODEL=openai/gpt-oss-20b
# Milliseconds to wait between calls in the evaluation script (free tiers have rate limits).
EVAL_DELAY_MS=2500
PORT=3000
